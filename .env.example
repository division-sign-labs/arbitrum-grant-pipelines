# Copy to .env and fill in. Nothing here is read at import time except via config/settings.py.

# Dune Analytics — https://dune.com/settings/api
# Used for every bulk join (farcaster verifications, arbitrum.creation_traces, dex.trades, robinhood.*).
DUNE_API_KEY=

# Neynar — https://dev.neynar.com  (Starter plan = 300 rpm is enough)
# Used for the /arbitrum channel feed and as the evangelism cast-search fallback.
NEYNAR_API_KEY=

# Neo4j — the existing quotient graph. Ingestion MERGEs into WarpcastAccount/Wallet nodes here.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional overrides (defaults live in config/settings.py)
# BACKFILL_START=2025-01-01
# DUNE_PERFORMANCE=medium
